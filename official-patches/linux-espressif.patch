diff --git a/arch/riscv/boot/dts/espressif/esp32s31.dts b/arch/riscv/boot/dts/espressif/esp32s31.dts
new file mode 100644
index 00000000000000..c0b39b79088369
--- /dev/null
+++ b/arch/riscv/boot/dts/espressif/esp32s31.dts
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Minimal ESP32-S31 device tree.
+ *
+ * U-Boot initializes PSRAM and maps the NOR flash XIP window before Linux
+ * starts. OpenSBI owns the machine-mode CLIC bank and provides cache
+ * maintenance through vendor SBI calls.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/clock/esp32s31.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/pinctrl/esp32s31-iomux.h>
+#include <dt-bindings/reset/esp32s31.h>
+
+/ {
+	compatible = "esp,esp32s31";
+	#address-cells = <1>;
+	#size-cells = <1>;
+	model = "Espressif ESP32-S31 (minimal)";
+
+	aliases {
+		ethernet0 = &emac;
+		i2c0 = &i2c0;
+		serial0 = &uart0;
+	};
+
+	xtal_clk: clock-xtal {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <40000000>;
+	};
+
+	mpll_clk: clock-mpll {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <500000000>;
+	};
+
+	chosen {
+		bootargs =
+		"earlycon=sbi console=ttyS0 root=mtd:rootfs rootfstype=cramfs ro swiotlb=128";
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		timebase-frequency = <320000000>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			reg = <0>;
+			compatible = "riscv";
+			riscv,isa = "rv32imac_zicsr_zifencei";
+			riscv,isa-base = "rv32i";
+			riscv,isa-extensions = "i", "m", "a", "c", "zicsr",
+					       "zifencei";
+			mmu-type = "riscv,sv32";
+			clock-frequency = <320000000>;
+
+			cpu0_intc: interrupt-controller {
+				#interrupt-cells = <1>;
+				interrupt-controller;
+				compatible = "riscv,cpu-intc";
+			};
+		};
+	};
+
+	memory@50000000 {
+		device_type = "memory";
+		reg = <0x50000000 0x01000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		dma_pool: dma-pool@2f030000 {
+			compatible = "shared-dma-pool";
+			linux,dma-default;
+			no-map;
+			reg = <0x2f030000 0x40000>;
+		};
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		clic: interrupt-controller@10a00000 {
+			compatible = "esp,esp32s31-clic";
+			reg = <0x10a00000 0x2000>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&cpu0_intc>;
+		};
+
+		intmtx: interrupt-controller@20585000 {
+			compatible = "esp,esp32s31-intmtx";
+			reg = <0x20585000 0x800>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&clic>;
+		};
+
+		uart0: serial@2038a000 {
+			compatible = "esp,esp32s3-uart";
+			reg = <0x2038a000 0x100>;
+			clocks = <&xtal_clk>;
+			current-speed = <115200>;
+			interrupt-parent = <&intmtx>;
+			interrupts = <9 IRQ_TYPE_LEVEL_HIGH>;
+			status = "okay";
+		};
+
+		/*
+		 * USB-Serial/JTAG. A syscon because its PHY configuration register
+		 * also holds the GPIO33/34 pad enable, which pinctrl clears.
+		 */
+		usb_jtag: syscon@20391000 {
+			compatible = "esp,esp32s31-usb-serial-jtag", "syscon";
+			reg = <0x20391000 0x1000>;
+		};
+
+		pinctrl: pinctrl@20582000 {
+			compatible = "esp,esp32s31-pinctrl";
+			reg = <0x20582000 0x100>,
+			      <0x20583000 0xe00>,
+			      <0x20588000 0x400>;
+			reg-names = "iomux", "matrix", "cnnt";
+			esp,usb-jtag = <&usb_jtag>;
+			clocks = <&clk ESP_S31_CLK_IOMUX_APB>,
+				 <&clk ESP_S31_CLK_IOMUX>;
+			clock-names = "apb", "iomux";
+			resets = <&rst ESP_S31_RST_IOMUX>;
+
+			espfunc: espfunc {
+				/*
+				 * I2C Pins - SDA(GPIO51) and SCL(GPIO50) according to
+				 * ESP32S31 Core FunctionBoard v1.1 schematic.
+				 */
+				i2c0_pins: i2c0-pins {
+					pinmux =
+						<ESP_PINMUX(51, ESP_FUNC_S31_I2C0_SDA_ID)>,
+						<ESP_PINMUX(50, ESP_FUNC_S31_I2C0_SCL_ID)>;
+
+					input-enable;
+					bias-pull-up;
+					drive-strength = <5>;
+					drive-open-drain;
+				};
+
+				emac_pins: emac-pins {
+					pinmux =
+						/* MDC, MDIO */
+						<ESP_PINMUX(5, ESP_FUNC_S31_GMII_MDC_ID)>,
+						<ESP_PINMUX(6, ESP_FUNC_S31_GMII_MDIO_ID)>,
+						/* TXD0-3, TX_CTL, TX_CLK */
+						<ESP_PINMUX(8, ESP_FUNC_S31_GMAC_ID)>,
+						<ESP_PINMUX(9, ESP_FUNC_S31_GMAC_ID)>,
+						<ESP_PINMUX(10, ESP_FUNC_S31_GMAC_ID)>,
+						<ESP_PINMUX(11, ESP_FUNC_S31_GMAC_ID)>,
+						<ESP_PINMUX(12, ESP_FUNC_S31_GMAC_ID)>,
+						<ESP_PINMUX(13, ESP_FUNC_S31_GMAC_ID)>,
+						/* RX_CLK, RX_CTL, RXD3-0 */
+						<ESP_PINMUX(14, ESP_FUNC_S31_GMAC_ID)>,
+						<ESP_PINMUX(15, ESP_FUNC_S31_GMAC_ID)>,
+						<ESP_PINMUX(16, ESP_FUNC_S31_GMAC_ID)>,
+						<ESP_PINMUX(17, ESP_FUNC_S31_GMAC_ID)>,
+						<ESP_PINMUX(18, ESP_FUNC_S31_GMAC_ID)>,
+						<ESP_PINMUX(19, ESP_FUNC_S31_GMAC_ID)>;
+
+					input-enable;
+					bias-disable;
+					drive-strength = <20>;
+				};
+			};
+		};
+
+		gpio: gpio@20583000 {
+			compatible = "esp,esp32s31-gpio";
+			reg = <0x20583000 0xe00>;
+			reg-names = "gpio";
+			#gpio-cells = <2>;
+			gpio-controller;
+			ngpios = <62>;
+			/*
+			 * Pad settings live in the IO_MUX window, so claiming a
+			 * line has to reach pinctrl -- without this range,
+			 * setting a line to input returns -EPROBE_DEFER.
+			 */
+			gpio-ranges = <&pinctrl 0 0 62>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&intmtx>;
+			/* ETS_GPIO_INTR0..1_SOURCE = 61..62, one per bank */
+			interrupts = <61 IRQ_TYPE_LEVEL_HIGH>,
+				     <62 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		/*
+		 * HP_SYS_CLKRST. Peripheral clock gates and resets that sit
+		 * outside the peripherals' own register windows.
+		 */
+		sysctl: syscon@20587000 {
+			compatible = "esp,esp32s31-clkrst", "syscon",
+				     "simple-mfd";
+			reg = <0x20587000 0x400>;
+
+			/*
+			 * Register-less children. Both providers take the
+			 * HP_SYS_CLKRST window from this parent node and the
+			 * CNNT_SYS one, described below, by phandle.
+			 */
+			clk: clock-controller {
+				compatible = "esp,esp32s31-clk";
+				#clock-cells = <1>;
+				clocks = <&xtal_clk>, <&mpll_clk>;
+				clock-names = "xtal", "mpll";
+				esp,cnnt-sys = <&cnnt_sys>;
+			};
+
+			rst: reset-controller {
+				compatible = "esp,esp32s31-reset";
+				#reset-cells = <1>;
+				esp,cnnt-sys = <&cnnt_sys>;
+			};
+		};
+
+		/*
+		 * CNNT_SYS. The EMAC's RGMII mode, inversion and reference
+		 * clock selects, plus the clock gate and reset the providers
+		 * above drive.
+		 */
+		cnnt_sys: syscon@20359000 {
+			compatible = "esp,esp32s31-cnnt-sys", "syscon";
+			reg = <0x20359000 0x100>;
+		};
+
+		/*
+		 * HP_ALIVE_SYS. Carries the USB OTG-HS PHY glue -- the PLL and
+		 * suspend forcing, and the D+/D- pulldowns -- among unrelated
+		 * always-on control, so it is a shared syscon rather than a
+		 * window the PHY node claims for itself.
+		 */
+		hp_alive_sys: syscon@20589000 {
+			compatible = "esp,esp32s31-hp-alive-sys", "syscon";
+			reg = <0x20589000 0x100>;
+		};
+
+		i2c0: i2c@20385000 {
+			compatible = "esp,esp32s31-i2c";
+			reg = <0x20385000 0x1000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			interrupt-parent = <&intmtx>;
+			interrupts = <23 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk ESP_S31_CLK_I2C0_APB>,
+				 <&clk ESP_S31_CLK_I2C0>;
+			clock-names = "apb", "core";
+			assigned-clocks = <&clk ESP_S31_CLK_I2C0>;
+			assigned-clock-parents = <&xtal_clk>;
+			resets = <&rst ESP_S31_RST_I2C0>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&i2c0_pins>;
+			clock-frequency = <100000>;
+		};
+
+		/*
+		 * Synopsys DWMAC-3.70a, driven by stmmac through the
+		 * dwmac-esp32s31 glue.
+		 *
+		 * Only the Function-CoreBoard-1 carries a PHY. On a Korvo-1 this
+		 * node still probes and claims 14 pads, and never gets a link.
+		 */
+		emac: ethernet@20350000 {
+			compatible = "esp,esp32s31-dwmac", "snps,dwmac-3.70a";
+			reg = <0x20350000 0x2000>;
+			interrupt-parent = <&intmtx>;
+			/* ETS_SBD_INTR_SOURCE */
+			interrupts = <98 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "macirq";
+			clocks = <&clk ESP_S31_CLK_EMAC_SYS>,
+				 <&clk ESP_S31_CLK_EMAC_REF>,
+				 <&clk ESP_S31_CLK_EMAC_PTP>;
+			clock-names = "stmmaceth", "ref", "ptp_ref";
+			assigned-clocks = <&clk ESP_S31_CLK_EMAC_REF>;
+			assigned-clock-parents = <&mpll_clk>;
+			resets = <&rst ESP_S31_RST_EMAC>;
+			reset-names = "stmmaceth";
+			esp,cnnt-sys = <&cnnt_sys>;
+			dma-noncoherent;
+			snps,force_thresh_dma_mode;
+			snps,txpbl = <32>;
+			snps,rxpbl = <8>;
+			snps,no-pbl-x8;
+			snps,mixed-burst;
+			phy-mode = "rgmii-id";
+			phy-handle = <&phy0>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&emac_pins>;
+			max-speed = <100>;
+
+			mdio {
+				compatible = "snps,dwmac-mdio";
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				/*
+				 * Motorcomm YT8531 (IDR1 0x4f51, IDR2 0xe91b).
+				 */
+				phy0: ethernet-phy@0 {
+					compatible = "ethernet-phy-id4f51.e91b";
+					reg = <0>;
+					reset-gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
+					reset-assert-us = <10000>;
+					reset-deassert-us = <500000>;
+				};
+			};
+		};
+
+		systimer: timer@20399000 {
+			compatible = "esp,esp32s31-systimer";
+			reg = <0x20399000 0x100>;
+			clock-frequency = <16000000>;
+			interrupt-parent = <&intmtx>;
+			interrupts = <33 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "target0";
+		};
+
+		usb_phy: usb-phy@20380000 {
+			compatible = "esp,esp32s31-usb-phy";
+			reg = <0x20380000 0x20>;
+			#phy-cells = <0>;
+			clocks = <&clk ESP_S31_CLK_USB_OTGHS_PHYREF>;
+			clock-names = "ref";
+			esp,hp-alive-sys = <&hp_alive_sys>;
+			esp,cnnt-sys = <&cnnt_sys>;
+		};
+
+		usb: usb@20300000 {
+			compatible = "esp,esp32s31-hsotg", "snps,dwc2";
+			reg = <0x20300000 0x40000>;
+			interrupt-parent = <&intmtx>;
+			/* ETS_USB_OTGHS_INTR_SOURCE */
+			interrupts = <99 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk ESP_S31_CLK_USB_OTGHS_BUS>;
+			clock-names = "otg";
+			resets = <&rst ESP_S31_RST_USB_OTGHS>;
+			reset-names = "dwc2";
+			phys = <&usb_phy>;
+			phy-names = "usb2-phy";
+			dr_mode = "host";
+			dma-noncoherent;
+		};
+
+		rootflash: flash@40b00000 {
+			compatible = "mtd-rom";
+			reg = <0x40b00000 0x00400000>;
+			bank-width = <4>;
+			linux,mtd-name = "rootfs";
+			#address-cells = <1>;
+			#size-cells = <1>;
+		};
+	};
+};
