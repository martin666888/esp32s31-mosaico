--- a/arch/riscv/kernel/entry.S
+++ b/arch/riscv/kernel/entry.S
@@ -20,6 +20,21 @@
 
 	.section .irqentry.text, "ax"
 
+/*
+ * ESP32-S31 CLIC quirk: scause has CLIC extension bits in [30:12]
