+	not t1, t1		/* mirror sstatus.SPP/SPIE and must be kept */
+	and t0, t0, t1		/* (they were saved at trap entry) */
+	li t1, 0x80000000	/* force interrupt-type so sret reloads sil */
+	or t0, t0, t1
+	csrw CSR_CAUSE, t0
+#endif
