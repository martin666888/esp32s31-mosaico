 	REG_L x3,  PT_GP(sp)
 	REG_L x4,  PT_TP(sp)
@@ -307,6 +362,7 @@ SYM_CODE_START_LOCAL(handle_kernel_stack_overflow)
 	csrr s2, CSR_EPC
 	csrr s3, CSR_TVAL
 	csrr s4, CSR_CAUSE
+	mask_clic_scause s4, t0	/* ESP32-S31: strip CLIC SPP/SPIL bits */
 	csrr s5, CSR_SCRATCH
 	REG_S s0, PT_SP(sp)
 	REG_S s1, PT_STATUS(sp)
