+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Board-specific U-Boot config header for ESP32-S31.
+ *
+ * Copyright (C) 2026, Espressif Systems (Shanghai) CO LTD
+ */
+
+#ifndef __ESP32S31_CONFIG_H
