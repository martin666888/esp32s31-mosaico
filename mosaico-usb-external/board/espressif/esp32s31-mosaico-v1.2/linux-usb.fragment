CONFIG_LOCALVERSION="-mosaico-v1.2-usb"
CONFIG_DEFAULT_HOSTNAME="esp-mosaico"
# CONFIG_STMMAC_ETH is not set
# CONFIG_I2C is not set
# CONFIG_USB is not set
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_PHY_ESP32S31_USB=y
CONFIG_USB_G_NCM=y
CONFIG_SPI=y
CONFIG_SPI_ESP32S31=y
