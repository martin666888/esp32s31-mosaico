--- /dev/null
+++ b/drivers/spi/spi-esp32s31.c
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Espressif ESP32-S31 GPSPI2 controller driver.
+ *
+ * Stage 1: platform driver registration and Device Tree matching only.
+ * No register is touched yet, so probing is safe even before the GPSPI2
+ * base address and clock gating have been confirmed on hardware.
+ *
+ * Copyright (C) 2026 Espressif Systems (Shanghai) CO LTD
+ */
+
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+static int esp32s31_spi_probe(struct platform_device *pdev)
+{
+	dev_info(&pdev->dev, "matched, hardware support not implemented yet\n");
+
+	return 0;
+}
+
+static const struct of_device_id esp32s31_spi_of_match[] = {
+	{ .compatible = "esp,esp32s31-spi2", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, esp32s31_spi_of_match);
+
+static struct platform_driver esp32s31_spi_driver = {
+	.probe = esp32s31_spi_probe,
+	.driver = {
+		.name = "esp32s31-spi",
+		.of_match_table = esp32s31_spi_of_match,
+	},
+};
+module_platform_driver(esp32s31_spi_driver);
+
+MODULE_DESCRIPTION("Espressif ESP32-S31 GPSPI2 controller driver");
+MODULE_LICENSE("GPL");
--- a/drivers/spi/Kconfig
+++ b/drivers/spi/Kconfig
@@ -411,6 +411,14 @@
 	  This enables using the Cirrus EP93xx SPI controller in master
 	  mode.
 
+config SPI_ESP32S31
+	tristate "Espressif ESP32-S31 GPSPI2 master controller"
+	depends on ARCH_ESPRESSIF || COMPILE_TEST
+	depends on OF
+	help
+	  Say Y here to include support for the GPSPI2 master controller
+	  found in the Espressif ESP32-S31.
+
 config SPI_FALCON
 	bool "Falcon SPI controller support"
 	depends on SOC_FALCON
--- a/drivers/spi/Makefile
+++ b/drivers/spi/Makefile
@@ -56,6 +56,7 @@
 obj-$(CONFIG_SPI_DW_MMIO)		+= spi-dw-mmio.o
 obj-$(CONFIG_SPI_DW_PCI)		+= spi-dw-pci.o
 obj-$(CONFIG_SPI_EP93XX)		+= spi-ep93xx.o
+obj-$(CONFIG_SPI_ESP32S31)		+= spi-esp32s31.o
 obj-$(CONFIG_SPI_FALCON)		+= spi-falcon.o
 obj-$(CONFIG_SPI_FSI)			+= spi-fsi.o
 obj-$(CONFIG_SPI_FSL_CPM)		+= spi-fsl-cpm.o
