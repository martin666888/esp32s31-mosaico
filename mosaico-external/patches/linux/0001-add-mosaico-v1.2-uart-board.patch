--- a/arch/riscv/boot/dts/espressif/Makefile
+++ b/arch/riscv/boot/dts/espressif/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0
 
 dtb-$(CONFIG_ARCH_ESPRESSIF) += esp32s31.dtb
+dtb-$(CONFIG_ARCH_ESPRESSIF) += esp32s31-mosaico-v1.2.dtb
--- /dev/null
+++ b/arch/riscv/boot/dts/espressif/esp32s31-mosaico-v1.2.dts
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+#include "esp32s31.dts"
+
+/ {
+    model = "Espressif ESP-Mosaico V1.2 (UART bring-up)";
+
+    chosen {
+        stdout-path = "serial0:115200n8";
+    };
+};
+
+&emac {
+    status = "disabled";
+};
+
+&i2c0 {
+    status = "disabled";
+};
+
+&usb {
+    status = "disabled";
+};
+
+&usb_phy {
+    status = "disabled";
+};
